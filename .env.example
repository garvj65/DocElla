NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=1
GROQ_MAX_INPUT_CHARACTERS=30000

# Optional. Required only for scanned PDFs, images, Office documents, and HTML.
# Configure both values together and keep them backend-only.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=90000
AZURE_DOCUMENT_INTELLIGENCE_POLL_INTERVAL_MS=500

EXTRACT_RATE_LIMIT_WINDOW_MS=60000
EXTRACT_RATE_LIMIT_MAX=10

GENERATE_RATE_LIMIT_WINDOW_MS=60000
GENERATE_RATE_LIMIT_MAX=20

VITE_API_BASE_URL=http://localhost:3001
